# Copy to .env and set real secrets. These are SAFE EXAMPLES, not credentials.

# PostgreSQL (internal to the compose network; not published to host)
POSTGRES_DB=churn
POSTGRES_USER=churn
POSTGRES_PASSWORD=change-me-db-password

# Initial admin login — created once on first start if no user exists.
# No universal default: you must set this before first run.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-admin-password

# Optional one-shot bootstrap import of the source snapshot (explicit).
# Leave empty to skip. Path is INSIDE the app container.
# Example after copying data.json into the container:
#   BOOTSTRAP_SEED_FILE=/seed/data.json
BOOTSTRAP_SEED_FILE=

# Set to "true" only when serving over HTTPS (Secure cookie flag).
HTTPS_ENABLED=false
EVAL_REFRESH_SECONDS=

# Optional AI brief — server-side only. Leave empty to keep the feature off.
# Endpoint must be https and in AI_ALLOWED_HOSTS (comma-separated);
# non-HTTPS, internal and metadata addresses are rejected.
AI_API_KEY=
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_ALLOWED_HOSTS=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com
AI_TIMEOUT_SECONDS=30
AI_MAX_RESPONSE_BYTES=1048576
